# Preview Hub configuration. Copy this file to .env and adjust as needed.
# Placeholders only — never commit real secrets or machine-specific values.
# Both settings have safe defaults, so a .env file is optional.

# HTTP port the hub listens on (used for both the host and container side).
HUB_PORT=8788

# How often the PWA polls /api/previews, in milliseconds.
POLL_INTERVAL_MS=10000
